# Analytics du site (facultatif : sans identifiant, aucun script tiers n’est chargé).
VITE_GA_MEASUREMENT_ID=

# Origine utilisée par le pré-rendu et par la publication Instagram.
# SITE_URL=https://wikibrico.fr

# Publication Instagram (voir docs/poster-sur-instagram.md).
# Jeton longue durée d’un compte professionnel, jamais committé.
INSTAGRAM_ACCESS_TOKEN=
# Aucun identifiant de compte à renseigner : le jeton fait foi.
# INSTAGRAM_GRAPH_VERSION=v25.0

# Copie sur la Page Facebook (même doc, « La Page Facebook »).
FACEBOOK_PAGE_TOKEN=
FACEBOOK_PAGE_ID=

# Régénération des jetons : lus par --jeton-page et --jeton-ig, jamais en CI.
APP_ID=
APP_SECRET=
APP_SECRET_IG=
# Jeton d’une heure de l’Explorer, à coller le jour de la régénération.
JETON_COURT=
